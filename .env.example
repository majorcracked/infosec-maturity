# --- AegisFlow Production Environment Variables ---

# PostgreSQL Database URL
DATABASE_URL="postgresql://postgres:1212@localhost:5432/AegisFlow?schema=public"

# Next.js Server Port
PORT=3000

# --- Live Security Connector Integrations (Optional) ---

# 1. Okta Directory Settings
# Domain should exclude HTTPS protocol (e.g. dev-123456.oktapreview.com)
OKTA_DOMAIN=""
OKTA_API_TOKEN=""

# 2. AWS IAM & Storage Settings
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Target production S3 bucket to run AES-256 encryption status checks
AWS_PRODUCTION_BUCKET=""

# 3. GitHub Branch Protection Settings
GITHUB_PAT=""
# Repository owner (username/org) and repository name to verify
GITHUB_OWNER=""
GITHUB_REPO=""

# 4. Ollama Local AI Model Setting
# Default model name running on local Ollama service (e.g. qwen2.5:7b, llama3)
OLLAMA_MODEL="qwen2.5:7b"
